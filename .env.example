# ============================================================
# KGP PAWS — environment variables
# Copy to .env.local and fill in what you have.
# EVERYTHING IS OPTIONAL: with no variables set, the app runs in
# fully-functional DEMO MODE (labelled seed data, localStorage writes).
# ============================================================

# ---------- Site ----------
# Canonical URL used for SEO metadata, sitemap and QR tag generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (database + auth + storage) ----------
# Create a project at https://supabase.com → Project Settings → API.
# Setting BOTH of these switches the app from demo mode to live mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for privileged operations (donation webhooks, QR admin).
# NEVER expose with NEXT_PUBLIC_. Used only in route handlers/server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Payments (Razorpay — UPI / PhonePe / Google Pay / cards) ----------
# https://dashboard.razorpay.com → API Keys. Donations are marked verified
# ONLY by the webhook handler after signature validation.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Map (optional upgrade from the built-in stylized SVG map) ----------
# https://account.mapbox.com → tokens. The privacy model (zone-level public
# data) is enforced in the data layer and applies to Mapbox rendering too.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------- Bot protection for public forms (optional, recommended) ----------
# Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
