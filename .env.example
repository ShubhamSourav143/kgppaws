# ============================================================
# KGP PAWS — environment variables
# Copy to .env.local and fill in what you have.
# EVERYTHING IS OPTIONAL: with no variables set, the app runs in
# fully-functional DEMO MODE (labelled seed data, localStorage writes).
# ============================================================

# ---------- Site ----------
# Canonical URL used for SEO metadata, sitemap and QR tag generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Supabase (database + auth + storage) ----------
# Create a project at https://supabase.com → Project Settings → API.
# Setting BOTH of these switches the app from demo mode to live mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only key for privileged operations (donation webhooks, QR admin).
# NEVER expose with NEXT_PUBLIC_. Used only in route handlers/server actions.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Google Sheets CMS + Drive media sync ----------
# A Google Cloud service account with the Sheets API and Drive API enabled.
# Share the target Spreadsheet AND Drive folder with the service account's
# client_email as Editor, then paste its full JSON key here as one line.
# Setting these switches the sync/ingest routes from "not configured" (204,
# no-op) to live. See docs/GOOGLE_SHEETS_SCHEMA.md for the sheet layout and
# docs/ARCHITECTURE.md §6-7 for the sync/ingest design.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Shared secret required in the `x-cron-secret` header by /api/sync/run and
# /api/media/ingest — set this before wiring up Vercel Cron, so the routes
# aren't callable by anyone who finds the URL.
CRON_SECRET=

# ---------- Notifications ----------
# See docs/notifications-setup.md for step-by-step setup. Every successful
# form submission (bite/rescue/adoption/volunteer) pages the team by
# email; animal-rescue reports additionally page WhatsApp for life-safety.
# With any of these unset the corresponding channel is skipped (logged
# in notification_outbox) rather than failing the submission.

# Email — Resend (https://resend.com)
RESEND_API_KEY=
# Sender must live on a domain verified in Resend
NOTIFY_FROM_EMAIL=KGP PAWS <notify@yourdomain.org>
# Comma-separated recipients; all get every notification
NOTIFY_TO_EMAILS=team@yourdomain.org

# WhatsApp — Meta Cloud API (https://developers.facebook.com/docs/whatsapp/cloud-api)
# System-user token with whatsapp_business_messaging scope
WHATSAPP_ACCESS_TOKEN=
# Phone Number ID from WhatsApp API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Rescue coordinator's phone in E.164 — will be paged only for /report
RESCUE_WHATSAPP_TO=+91XXXXXXXXXX

# Legacy names still accepted as fallbacks:
#   EMAIL_PROVIDER_API_KEY   → same as RESEND_API_KEY
#   WHATSAPP_PROVIDER_TOKEN  → same as WHATSAPP_ACCESS_TOKEN
EMAIL_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_TOKEN=

# ---------- UPI donations (no payment gateway — see docs/PRD.md §5.D) ----------
# Shown on the Donate page: QR image path(s) in Storage, UPI ID, and the
# account holder name. Set via the admin dashboard once live, or here for
# local testing.
NEXT_PUBLIC_UPI_ID=
NEXT_PUBLIC_UPI_HOLDER_NAME=

# ---------- Map (optional upgrade from the built-in stylized SVG map) ----------
# https://account.mapbox.com → tokens. The privacy model (zone-level public
# data) is enforced in the data layer and applies to Mapbox rendering too.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------- Bot protection for public forms (optional, recommended) ----------
# Cloudflare Turnstile: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
